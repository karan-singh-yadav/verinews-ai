# Copy to .env and fill in. Never commit .env.
MODEL_DIR=models
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Online verification providers (each optional; missing keys are reported, never faked)
GOOGLE_FACT_CHECK_API_KEY=
GDELT_ENABLED=true

# Backend
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=10
MAX_ARTICLE_CHARS=20000
MAX_FETCH_BYTES=2000000
CORS_ORIGINS=http://localhost:5173
FEEDBACK_PATH=data/feedback/feedback.jsonl
GDELT_MIN_INTERVAL_SECONDS=5.5

# Monitoring (events store derived numbers only, never article text)
MONITORING_ENABLED=true
MONITORING_LOG_PATH=data/monitoring/events.jsonl
DRIFT_WINDOW=2000
DRIFT_MIN_SAMPLES=100
MIN_REVIEW_LABELS=50

# Docker
WEB_PORT=8080
# Only trust X-Forwarded-For from these proxies (comma list or *). Compose sets * because the
# backend is not published; use your proxy's IP if you run uvicorn directly behind one.
FORWARDED_ALLOW_IPS=127.0.0.1
